{
  "name": "cineanime-studio",
  "version": "1.0.0",
  "description": "Estudio de Animación Anime Cinemático",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "author": "Uriel Cortes",
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.cineanime.studio",
    "productName": "CineAnime Studio",
    "asar": false,
    "files": [
      "main.js",
      "backend/**/*",
      "backend_bin/**/*",
      "frontend/**/*",
      "assets/**/*",
      "build/**/*"
    ],
    "mac": {
      "artifactName": "CineAnime.Studio-${version}.${ext}",
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "artifactName": "CineAnime.Studio.Setup.${version}.${ext}",
      "target": "nsis",
      "icon": "build/icon.png"
    }
  }
}
